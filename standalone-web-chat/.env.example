# Copy to .env and edit. Every value below is a synthetic placeholder.
# Generate secrets with:  openssl rand -hex 24

# --- Required ----------------------------------------------------------------
# Database password (use hex: it is placed inside a connection URL).
POSTGRES_PASSWORD=

# --- First operator (created on first start if that e-mail does not exist) ------
# Password: at least 10 characters. Remove these three lines after first login if
# you prefer to manage operators with the CLI (see README).
BOOTSTRAP_OPERATOR_EMAIL=operator@example.com
BOOTSTRAP_OPERATOR_PASSWORD=
BOOTSTRAP_OPERATOR_NAME=Support

# --- Network -----------------------------------------------------------------
# Host port and interface the app is published on.
HTTP_PORT=8080
BIND_ADDRESS=127.0.0.1
# Public URL of the chat (also accepted as a request/WebSocket origin). Set it in production.
# PUBLIC_URL=https://chat.example.com
# Number of reverse proxies in front of the app (0 = none). Raise to 1 behind
# nginx/Caddy so rate limits use the real client address.
TRUST_PROXY_HOPS=0
# Set true when served over HTTPS (marks the operator cookie Secure).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
# Sites allowed to embed the widget, comma separated origins. Empty = any site.
# ALLOWED_EMBED_ORIGINS=https://www.example.com,https://example.com

# --- Widget look & language ----------------------------------------------------
WIDGET_TITLE=Chat with us
WIDGET_GREETING=Hi! Ask us anything.
WIDGET_ACCENT=#2563eb
# en | uk
WIDGET_LOCALE=en

# --- CRM integration (optional) -------------------------------------------------
# Static bearer token for /api/integration/*. Leave empty to disable it (operator
# sessions can still use those endpoints).
INTEGRATION_API_TOKEN=

# --- Realtime (optional) -------------------------------------------------------
WS_MAX_CONNECTIONS=5000
WS_HEARTBEAT_SECONDS=30

# --- Abuse protection (defaults are sensible) -------------------------------------
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_LOGIN_PER_MINUTE=10
SPAM_PROTECTION=true
SPAM_MIN_FIRST_MESSAGE_CHARS=2
SPAM_CREATE_MAX_PER_WINDOW=10
SPAM_CREATE_WINDOW_SECONDS=600
SPAM_DUPLICATE_WINDOW_SECONDS=3600
# Loopback/private addresses skip the IP based spam rules (development, tests).
SPAM_EXEMPT_LOCAL=true
