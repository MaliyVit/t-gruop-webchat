{
  "name": "standalone-web-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted website chat: embeddable widget, realtime API and a minimal operator inbox.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/migrate.js",
    "operator": "node dist/create-operator.js",
    "test": "node --test dist-test/test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json",
    "e2e": "node scripts/e2e.mjs",
    "e2e:browser": "node scripts/browser-e2e.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "ws": "^8.18.0"
  }
}
